# ── AI Enrichment API Keys ────────────────────────────────────────────────────
# Copy this file to .env and fill in your keys.
# Both are FREE — no credit card required.

# Groq (PRIMARY — 14,400 free requests/day)
# Get key at: https://console.groq.com  → API Keys → Create API Key
GROQ_API_KEY=gsk_your_groq_key_here

# Gemini (FALLBACK — 1,500 free requests/day)
# Get key at: https://aistudio.google.com  → Get API key
GEMINI_API_KEY=AIza_your_gemini_key_here
